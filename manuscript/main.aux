\newlabel{tab:flops}{{2}{7}{Worked FLOP counts for Llama~3.1 70B. Attention is negligible on short chat prompts and only a few percent even at $S=4096$. Decode of $T$ tokens costs about $T$ times a single-token body pass, plus a cheap walk over the growing KV cache}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Peak arithmetic, HBM bandwidth, and ridge point. H100 BF16 is the \emph  {dense} tensor-core rate; NVIDIA's advertised 1979\,TFLOP/s includes 2:4 sparsity, which ordinary dense checkpoints do not use. TPU numbers are per chip~\citep {austin2025scaling}.}}{7}{table.3}\protected@file@percent }
\newlabel{tab:hw}{{3}{7}{Peak arithmetic, HBM bandwidth, and ridge point. H100 BF16 is the \emph {dense} tensor-core rate; NVIDIA's advertised 1979\,TFLOP/s includes 2:4 sparsity, which ordinary dense checkpoints do not use. TPU numbers are per chip~\citep {austin2025scaling}}{table.3}{}}
