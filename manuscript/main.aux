\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Work on a short chat question. The retrieval embedder $e(Q)$ is a separate small model. Prefill and decode use the serving Transformer.}}{5}{table.1}\protected@file@percent }
\newlabel{tab:who}{{1}{5}{Work on a short chat question. The retrieval embedder $e(Q)$ is a separate small model. Prefill and decode use the serving Transformer}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Anatomy of serving-model prefill. The host only tokenizes (and, optionally, runs a small retrieval embedder $e(Q)$). On the accelerator, token ids become an $S\times d$ residual stream by embedding lookup. Each of the $L$ decoder blocks applies RMSNorm, grouped-query projections, rotary positions, a causal $S\times S$ attention, an output projection, and a SwiGLU feed-forward, with residuals around both sub-layers. All $S$ positions are transformed in one weight load. The cache gate reads the last row $h(Q)$; the language-model head is unnecessary for that decision. The KV tensors are written to HBM only if decode will follow.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:prefill}{{1}{5}{Anatomy of serving-model prefill. The host only tokenizes (and, optionally, runs a small retrieval embedder $e(Q)$). On the accelerator, token ids become an $S\times d$ residual stream by embedding lookup. Each of the $L$ decoder blocks applies RMSNorm, grouped-query projections, rotary positions, a causal $S\times S$ attention, an output projection, and a SwiGLU feed-forward, with residuals around both sub-layers. All $S$ positions are transformed in one weight load. The cache gate reads the last row $h(Q)$; the language-model head is unnecessary for that decision. The KV tensors are written to HBM only if decode will follow}{figure.1}{}}
